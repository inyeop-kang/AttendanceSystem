<Window x:Class="AttendanceClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="출결관리 시스템 - 로그인"
        Height="320" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AI 출결관리 시스템" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="아이디"/>
            <TextBox x:Name="UsernameBox" Height="30" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="비밀번호"/>
            <PasswordBox x:Name="PasswordBox" Height="30" Margin="0,4,0,0"/>
        </StackPanel>

        <Button Grid.Row="6" Content="로그인" Height="36" Click="LoginButton_Click"/>

        <TextBlock Grid.Row="8" x:Name="MessageText" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center"/>
    </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AttendanceClient.LoginWindow" Title="출결관리 시스템 - 로그인" Width="860" Height="480" MinWidth="860" MinHeight="480" WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource Navy}" Padding="34">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ATTENDANCE MANAGEMENT" Foreground="#B4C5D4" FontSize="10" Margin="0,0,0,48"/>
                <TextBlock Text="얼굴로 확인하고,
정확하게 기록합니다." Foreground="White" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="교육생 출결 관리 시스템" Foreground="#CAD6E0" Margin="0,18,0,0"/>
                <TextBlock Text="교육생 등록부터 입실·퇴실 기록까지
하나의 프로그램에서 관리하세요." Foreground="#CAD6E0" Margin="0,14,0,0" FontSize="11"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="White" Padding="54,24">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="관리자 로그인" Style="{StaticResource Heading}"/>
                <TextBlock Text="관리자 계정으로 로그인해 주세요." Style="{StaticResource Caption}" Margin="0,12,0,20"/>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="아이디" Margin="0,0,0,6"/>
                    <TextBox x:Name="UsernameBox" Height="36"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="비밀번호" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordBox" Height="36"/>
                </StackPanel>
                <Button Content="로그인" Click="LoginButton_Click" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0,2,0,10"/>
                <TextBlock x:Name="MessageText" Foreground="#AA3F3F" TextWrapping="Wrap" MinHeight="36"/>
                <TextBlock Text="계정 문의는 시스템 관리자에게 연락해 주세요." Style="{StaticResource Caption}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

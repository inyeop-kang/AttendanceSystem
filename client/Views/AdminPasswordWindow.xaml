<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AttendanceClient.Views.AdminPasswordWindow" Title="관리자 인증" Width="420" Height="300" MinWidth="420" MinHeight="300" WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
    <StackPanel Margin="26">
        <TextBlock Text="관리자 인증" Style="{StaticResource Heading}"/>
        <TextBlock Text="관리자 모드로 전환하려면 비밀번호를 입력하세요." TextWrapping="Wrap" Margin="0,12,0,20"/>
        <PasswordBox x:Name="PasswordBox" Height="36"/>
        <TextBlock x:Name="MessageText" Foreground="#AA3F3F" TextWrapping="Wrap" MinHeight="40" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Click="CancelButton_Click" Style="{StaticResource SecondaryButton}" Width="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="확인" Click="ConfirmButton_Click" Style="{StaticResource PrimaryButton}" Width="80" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>

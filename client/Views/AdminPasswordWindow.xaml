<Window x:Class="AttendanceClient.Views.AdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="관리자 인증" Height="220" Width="340"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="True">
    <StackPanel Margin="20">
        <TextBlock Text="관리자 모드로 전환하려면 비밀번호를 입력하세요." TextWrapping="Wrap" Margin="0,0,0,12"/>

        <PasswordBox x:Name="PasswordBox" Height="30"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="취소" Width="80" Height="32" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="확인" Width="80" Height="32" Click="ConfirmButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="MessageText" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
</Window>

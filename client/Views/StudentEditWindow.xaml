<Window x:Class="AttendanceClient.Views.StudentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="교육생 정보" Height="420" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="교육생 번호"/>
        <TextBox x:Name="StudentNoBox" Height="30" Margin="0,4,0,12"/>

        <TextBlock Text="이름"/>
        <TextBox x:Name="NameBox" Height="30" Margin="0,4,0,12"/>

        <TextBlock Text="과정명"/>
        <TextBox x:Name="DepartmentBox" Height="30" Margin="0,4,0,12"/>

        <TextBlock Text="기수"/>
        <TextBox x:Name="GradeBox" Height="30" Margin="0,4,0,20"/>

        <Button Content="저장" Height="36" Click="SaveButton_Click"/>

        <TextBlock x:Name="MessageText" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
</Window>

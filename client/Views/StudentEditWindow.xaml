<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AttendanceClient.Views.StudentEditWindow" Title="교육생 정보" Width="640" Height="410" MinWidth="640" MinHeight="410" WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Heading}"/>
            <TextBlock Text="교육생 번호와 이름은 필수 항목입니다." Style="{StaticResource Caption}" Margin="0,10,0,20"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="교육생 번호 *" Margin="0,0,0,6"/>
                        <TextBox x:Name="StudentNoBox" Height="36"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="과정명" Margin="0,0,0,6"/>
                        <TextBox x:Name="DepartmentBox" Height="36"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="이름 *" Margin="0,0,0,6"/>
                        <TextBox x:Name="NameBox" Height="36"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="기수 (숫자)" Margin="0,0,0,6"/>
                        <TextBox x:Name="GradeBox" Height="36"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="MessageText" Foreground="#AA3F3F" TextWrapping="Wrap" MinHeight="32" Margin="0,10,0,0"/>
            <Button Content="저장" Click="SaveButton_Click" Style="{StaticResource PrimaryButton}" Width="110" HorizontalAlignment="Right" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>

<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AttendanceClient.Views.StudentStatsView" Loaded="StudentStatsView_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="82"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="교육생 개별 통계" Style="{StaticResource Heading}" VerticalAlignment="Top"/>
            <TextBlock x:Name="StudentInfoText" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="교육생" Margin="0,0,8,0"/>
            <ComboBox x:Name="StudentComboBox" Width="176" Height="34" AutomationProperties.Name="교육생 선택">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text=" ("/>
                            <TextBlock Text="{Binding StudentNo}"/>
                            <TextBlock Text=")"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="기간" Margin="12,0,8,0"/>
            <DatePicker x:Name="StartDatePicker" Width="128"/>
            <TextBlock Text="~" Margin="6,0"/>
            <DatePicker x:Name="EndDatePicker" Width="128"/>
            <Button Content="조회" Click="RefreshButton_Click" Style="{StaticResource PrimaryButton}" Width="66" Margin="10,0,0,10"/>
        </StackPanel>
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,-8,10">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                <Grid>
                    <TextBlock Text="출석일" Foreground="{StaticResource Muted}" VerticalAlignment="Top" FontSize="11"/>
                    <TextBlock x:Name="PresentDayText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#245C8A" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                <Grid>
                    <TextBlock Text="결석일" Foreground="{StaticResource Muted}" VerticalAlignment="Top" FontSize="11"/>
                    <TextBlock x:Name="AbsentDayText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#AA3F3F" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                <Grid>
                    <TextBlock Text="출석률" Foreground="{StaticResource Muted}" VerticalAlignment="Top" FontSize="11"/>
                    <TextBlock x:Name="AttendanceRateText" Text="0%" FontSize="24" FontWeight="Bold" Foreground="#19344F" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                <Grid>
                    <TextBlock Text="평균 체류" Foreground="{StaticResource Muted}" VerticalAlignment="Top" FontSize="11"/>
                    <TextBlock x:Name="AverageStayText" Text="-" FontSize="18" FontWeight="Bold" Foreground="#617183" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </UniformGrid>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="평균 입실" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock x:Name="AverageCheckInText" Text="-" FontWeight="SemiBold" Margin="6,0,18,0"/>
                <TextBlock Text="평균 퇴실" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock x:Name="AverageCheckOutText" Text="-" FontWeight="SemiBold" Margin="6,0,18,0"/>
                <TextBlock Text="총 체류" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock x:Name="TotalStayText" Text="-" FontWeight="SemiBold" Margin="6,0,18,0"/>
                <TextBlock Text="퇴실 미기록" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock x:Name="MissingCheckOutText" Text="0일" FontWeight="SemiBold" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="4">
            <TextBlock Text="일자별 기록" FontWeight="Bold"/>
            <TextBlock x:Name="OperatingDayText" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
        </Grid>
        <DataGrid Grid.Row="5" x:Name="StatsGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="날짜" Binding="{Binding Date}" Width="100" MinWidth="30"/>
                <DataGridTemplateColumn Header="상태" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource StatusText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="입실" Binding="{Binding CheckInTime}" Width="90" MinWidth="30"/>
                <DataGridTextColumn Header="퇴실" Binding="{Binding CheckOutTime}" Width="90" MinWidth="30"/>
                <DataGridTextColumn Header="체류 시간" Binding="{Binding StayDuration}" Width="*" MinWidth="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

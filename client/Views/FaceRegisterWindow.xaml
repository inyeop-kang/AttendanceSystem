<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AttendanceClient.Views.FaceRegisterWindow" Title="얼굴 등록" Width="860" Height="480" MinWidth="860" MinHeight="480" WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="StudentInfoText" FontSize="20" FontWeight="Bold"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <Border Background="#E2E9EF">
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="얼굴 촬영 안내" FontSize="16" FontWeight="Bold" Margin="0,0,0,18"/>
                    <TextBlock Text="1. 카메라를 정면으로 바라봐 주세요.
2. 고개를 살짝 좌우로 움직여 주세요.
3. 약 1~2초간 여러 장을 촬영합니다." TextWrapping="Wrap" LineHeight="23"/>
                    <TextBlock Text="촬영 중 얼굴이 가려지지 않도록 해 주세요." Style="{StaticResource Caption}" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="촬영 준비 중" TextWrapping="Wrap" Margin="0,0,16,0"/>
            <Button Content="촬영 시작" Click="CaptureButton_Click" Style="{StaticResource PrimaryButton}" x:Name="CaptureButton" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="AttendanceClient.Views.FaceRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="얼굴 등록" Height="640" Width="560"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="StudentInfoText" FontSize="18" FontWeight="Bold"/>

        <Border Grid.Row="2" Background="Black">
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
        </Border>

        <TextBlock Grid.Row="4" Text="&quot;촬영 시작&quot; 버튼을 누른 뒤, 고개를 살짝 좌우로 움직여 주세요. 1~2초간 자동으로 여러 장을 촬영합니다."
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Button x:Name="CaptureButton" Content="촬영 시작" Width="120" Height="36" Click="CaptureButton_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AttendanceClient.Views" x:Class="AttendanceClient.Views.KioskWindow" Title="출석 키오스크" Width="860" Height="480" MinWidth="860" MinHeight="480" WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
            <TextBlock Text="얼굴 인식 출석" Style="{StaticResource Heading}" DockPanel.Dock="Left"/>
            <Button Content="관리자 모드" Click="AdminModeButton_Click" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Width="112" VerticalAlignment="Top"/>
        </DockPanel>
        <local:AttendanceCheckView Grid.Row="1"/>
    </Grid>
</Window>

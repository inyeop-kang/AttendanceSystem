<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AttendanceClient.Views.AttendanceCheckView" Unloaded="AttendanceCheckView_Unloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>
            <Border Background="#E2E9EF">
                <Grid>
                    <TextBlock Text="웹캠 시작 버튼을 눌러 주세요" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="웹캠 시작" Click="StartButton_Click" Style="{StaticResource SecondaryButton}" x:Name="StartButton" Width="100"/>
                <Button Content="웹캠 정지" Click="StopButton_Click" Style="{StaticResource SecondaryButton}" x:Name="StopButton" Width="100" Margin="8,0,0,0" IsEnabled="False"/>
            </StackPanel>
        </Grid>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="입실 · 퇴실" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Button Content="입실" Click="CheckInButton_Click" Style="{StaticResource PrimaryButton}" x:Name="CheckInButton" IsEnabled="False" Margin="0,0,4,0"/>
                        <Button Content="퇴실" Click="CheckOutButton_Click" Style="{StaticResource SecondaryButton}" x:Name="CheckOutButton" IsEnabled="False" Margin="4,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="인식 결과" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ResultNameText" Text="인식 대기 중" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ResultDeptText" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="ResultConfidenceText" Margin="0,10,0,0"/>
                        <TextBlock x:Name="ResultStatusText" Margin="0,6,0,0" FontWeight="Bold"/>
                        <TextBlock x:Name="ResultMessageText" Text="웹캠을 시작한 후 입실 또는 퇴실을 눌러 주세요." Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource Soft}" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="안내   입실을 먼저 기록한 후 퇴실할 수 있습니다." FontSize="11" Foreground="{StaticResource Navy}"/>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="AttendanceClient.Views.AttendanceCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Unloaded="AttendanceCheckView_Unloaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="출석 처리 (얼굴 인식)" FontSize="22" FontWeight="Bold"/>

            <Border Grid.Row="2" Background="Black">
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <Button x:Name="StartButton" Content="웹캠 시작" Width="100" Height="36" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="웹캠 정지" Width="100" Height="36" Margin="8,0,0,0" Click="StopButton_Click" IsEnabled="False"/>
                <Button x:Name="CheckInButton" Content="입실" Width="100" Height="36" Margin="24,0,0,0" Click="CheckInButton_Click" IsEnabled="False"/>
                <Button x:Name="CheckOutButton" Content="퇴실" Width="100" Height="36" Margin="8,0,0,0" Click="CheckOutButton_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Border Grid.Column="2" Background="#F5F5F5" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="인식 결과" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock x:Name="ResultNameText" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="ResultDeptText" FontSize="14" Foreground="Gray" Margin="0,4,0,0"/>
                <TextBlock x:Name="ResultConfidenceText" Margin="0,12,0,0"/>
                <TextBlock x:Name="ResultStatusText" Margin="0,4,0,0" FontWeight="Bold"/>
                <TextBlock x:Name="ResultMessageText" Margin="0,16,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AttendanceClient.Views.AttendanceTodayView" Loaded="AttendanceTodayView_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="82"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="출석 현황" Style="{StaticResource Heading}" VerticalAlignment="Top"/>
            <TextBlock x:Name="GreetingText" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            <TextBlock x:Name="DateText" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="기간" Margin="0,0,8,0"/>
            <DatePicker x:Name="StartDatePicker" Width="138"/>
            <TextBlock Text="~" Margin="8,0"/>
            <DatePicker x:Name="EndDatePicker" Width="138"/>
            <Button Content="조회" Click="RefreshButton_Click" Style="{StaticResource PrimaryButton}" Width="70" Margin="10,0,0,10"/>
        </StackPanel>
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,-8,10">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                <Grid>
                    <TextBlock Text="전체 인원" Foreground="{StaticResource Muted}" VerticalAlignment="Top" FontSize="11"/>
                    <TextBlock x:Name="TotalCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#19344F" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                <Grid>
                    <TextBlock Text="입실" Foreground="{StaticResource Muted}" VerticalAlignment="Top" FontSize="11"/>
                    <TextBlock x:Name="CheckedInCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#245C8A" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                <Grid>
                    <TextBlock Text="퇴실" Foreground="{StaticResource Muted}" VerticalAlignment="Top" FontSize="11"/>
                    <TextBlock x:Name="CheckedOutCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#617183" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                <Grid>
                    <TextBlock Text="결석" Foreground="{StaticResource Muted}" VerticalAlignment="Top" FontSize="11"/>
                    <TextBlock x:Name="AbsentCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#AA3F3F" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </UniformGrid>
        <TextBlock Grid.Row="3" Text="교육생 출결 목록" FontWeight="Bold"/>
        <DataGrid Grid.Row="4" x:Name="AttendanceGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="날짜" Binding="{Binding Date}" Width="84" MinWidth="30"/>
                <DataGridTextColumn Header="교육생 번호" Binding="{Binding StudentNo}" Width="90" MinWidth="30"/>
                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="68" MinWidth="30"/>
                <DataGridTextColumn Header="과정명" Binding="{Binding Department}" Width="*" MinWidth="60"/>
                <DataGridTextColumn Header="기수" Binding="{Binding Grade}" Width="42" MinWidth="30"/>
                <DataGridTemplateColumn Header="상태" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource StatusText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="입실" Binding="{Binding CheckInTime}" Width="70" MinWidth="30"/>
                <DataGridTextColumn Header="퇴실" Binding="{Binding CheckOutTime}" Width="70" MinWidth="30"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

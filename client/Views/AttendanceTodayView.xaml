<UserControl x:Class="AttendanceClient.Views.AttendanceTodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="AttendanceTodayView_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="GreetingText" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock x:Name="DateText" FontSize="14" Foreground="Gray"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="출석 현황" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
            <TextBlock Text="기간" VerticalAlignment="Center"/>
            <DatePicker x:Name="StartDatePicker" Width="130" Margin="8,0,0,0"/>
            <TextBlock Text="~" VerticalAlignment="Center" Margin="6,0,6,0"/>
            <DatePicker x:Name="EndDatePicker" Width="130"/>
            <Button Content="조회" Width="70" Height="30" Margin="8,0,0,0" Click="RefreshButton_Click"/>
        </StackPanel>

        <UniformGrid Grid.Row="4" Columns="4" Height="80">
            <Border Background="#EAF6EC" Margin="4" CornerRadius="6">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="출석" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PresentCountText" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="#FFF8E1" Margin="4" CornerRadius="6">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="지각" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LateCountText" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="#FDECEA" Margin="4" CornerRadius="6">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="결석" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AbsentCountText" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="#ECEFF1" Margin="4" CornerRadius="6">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="전체 인원" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalCountText" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <DataGrid Grid.Row="6" x:Name="AttendanceGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="날짜" Binding="{Binding Date}" Width="100"/>
                <DataGridTextColumn Header="교육생 번호" Binding="{Binding StudentNo}" Width="110"/>
                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="100"/>
                <DataGridTextColumn Header="과정명" Binding="{Binding Department}" Width="150"/>
                <DataGridTextColumn Header="기수" Binding="{Binding Grade}" Width="60"/>
                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="출석시간" Binding="{Binding CheckInTime}" Width="100"/>
                <DataGridTextColumn Header="퇴실시간" Binding="{Binding CheckOutTime}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

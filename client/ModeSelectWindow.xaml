<Window x:Class="AttendanceClient.ModeSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 출결관리 시스템 - 모드 선택"
        Height="280" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="어떤 화면으로 시작할까요?" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

        <Button Grid.Row="2" Content="관리자 모드" Height="60" FontSize="16" Click="AdminModeButton_Click"/>

        <Button Grid.Row="4" Content="출석 모드" Height="60" FontSize="16" Click="KioskModeButton_Click"/>
    </Grid>
</Window>

<Window x:Class="AttendanceClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 출결관리 시스템"
        Height="794" Width="1123"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#2C3E50">
            <TextBlock Text="출결관리" Foreground="White" FontSize="20" FontWeight="Bold"
                       Margin="16,24,16,24" HorizontalAlignment="Center"/>

            <Button x:Name="AttendanceTodayButton" Content="출석 현황" Height="44" Margin="8,4" Click="AttendanceTodayButton_Click"/>
            <Button x:Name="StudentsButton" Content="교육생 관리" Height="44" Margin="8,4" Click="StudentsButton_Click"/>
            <Button x:Name="AttendanceCheckButton" Content="출석 모드" Height="44" Margin="8,4" Click="AttendanceCheckButton_Click"/>
        </StackPanel>

        <ContentControl x:Name="ContentArea" Grid.Column="1" Margin="16"/>
    </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AttendanceClient.MainWindow" Title="출결관리 시스템" Width="860" Height="480" MinWidth="860" MinHeight="480" WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="148"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource Navy}" Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="출결관리" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,6,0,8"/>
                    <TextBlock Text="관리자" Foreground="#B4C5D4" FontSize="11" Margin="0,0,0,24"/>
                    <Button Content="출석 현황" Click="AttendanceTodayButton_Click" Style="{StaticResource NavButton}" x:Name="AttendanceTodayButton"/>
                    <Button Content="교육생 관리" Click="StudentsButton_Click" Style="{StaticResource NavButton}" x:Name="StudentsButton"/>
                    <Button Content="개별 통계" Click="StudentStatsButton_Click" Style="{StaticResource NavButton}" x:Name="StudentStatsButton"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Button Content="출석 모드로 전환" Click="AttendanceCheckButton_Click" Style="{StaticResource NavButton}" x:Name="AttendanceCheckButton" FontSize="11" Padding="5,6"/>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>
        <ContentControl x:Name="ContentArea" Grid.Column="1" Margin="20"/>
    </Grid>
</Window>
